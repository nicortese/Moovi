PORT=3001
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=moovi_db
# false en localhost. true en Clever Cloud.
# Con true se verifica el certificado. DB_SSL_CA es el PEM de la CA, o la ruta a ese archivo.
DB_SSL=false
DB_SSL_CA=

JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRES_IN=7d

# Obtenerlo de https://www.themoviedb.org/settings/api → Read Access Token
TMDB_ACCESS_TOKEN=
TMDB_COUNTRY=AR

# Chatbot (Gemini). Key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
